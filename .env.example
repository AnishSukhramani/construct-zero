# Copy to .env (install.sh / init create this for you). Never commit .env.
# Required: Cursor dashboard → API Keys — inference billed via your Cursor plan.
CURSOR_API_KEY=

# Hermes provider placeholder (not adapter HTTP auth; leave as unused)
CZ_API_KEY=unused

# Voice Presentation Layer (optional; layered spoken delivery for long replies)
CZ_VPL_ENABLED=1
CZ_VPL_LAYER_THRESHOLD_ITEMS=5
CZ_VPL_MAX_BUCKETS=4
CZ_VPL_PASSTHROUGH_MAX_WORDS=400
CZ_VPL_SESSION_TTL_SEC=1800
