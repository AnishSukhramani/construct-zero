# Copy to .env and export in your shell, or add to ~/.zshrc
# Cursor Dashboard → API Keys / Integrations
CURSOR_API_KEY=

# Hermes Construct-Zero provider may require a value; not a paid Cursor key
CZ_API_KEY=unused

# Voice Presentation Layer (optional; layered spoken delivery for long replies)
CZ_VPL_ENABLED=1
CZ_VPL_LAYER_THRESHOLD_ITEMS=5
CZ_VPL_MAX_BUCKETS=4
CZ_VPL_PASSTHROUGH_MAX_WORDS=400
CZ_VPL_SESSION_TTL_SEC=1800
