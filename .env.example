# Copy to .env and export in your shell, or add to ~/.zshrc
# Cursor Dashboard → API Keys / Integrations
CURSOR_API_KEY=

# Hermes HCX provider may require a value; not a paid Cursor key
HCX_API_KEY=unused

# Voice Presentation Layer (optional; layered spoken delivery for long replies)
HCX_VPL_ENABLED=1
HCX_VPL_LAYER_THRESHOLD_ITEMS=5
HCX_VPL_MAX_BUCKETS=4
HCX_VPL_PASSTHROUGH_MAX_WORDS=400
HCX_VPL_SESSION_TTL_SEC=1800
