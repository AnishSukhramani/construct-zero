{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "object", "choices"],
  "properties": {
    "id": { "type": "string" },
    "object": { "const": "chat.completion.chunk" },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "delta"],
        "properties": {
          "index": { "type": "integer" },
          "delta": { "type": "object" },
          "finish_reason": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
