adapter:
  host: 127.0.0.1
  port: 8765
  # Optional bearer for /v1/* (leave empty for open loopback)
  api_key: ""

inference:
  backend: cursor
  model: auto
  cursor:
    api_key_env: CURSOR_API_KEY
    # ask = inference only; Hermes owns tools. Never use agent.
    mode: ask
    # Use the user project root as Cursor cwd (never CZ's own source when nested).
    workspace_isolation: true
    tool_timeout_s: 300   # or env CZ_TOOL_TIMEOUT_S
  # Future: claude_code driver (stub only in MVP)
  claude_code:
    enabled: false
  # BYO company LLM (Azure / vLLM / Ollama / LiteLLM) — see docs/recipes/backend-openai-compat.md
  # openai_compat:
  #   preset: generic
  #   base_url: https://llm.corp.example/v1
  #   api_key_env: CZ_OPENAI_COMPAT_API_KEY

# Optional: cheaper Cursor model for Hermes auxiliary tasks
# (set in ~/.hermes/config.yaml auxiliary.*.model after Construct-Zero works)
# auxiliary_model: composer-2.5
